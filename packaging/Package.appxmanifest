<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest for the Windows AI flavor (see packaging/build-windows-ai.ps1).

  The Microsoft.Windows.AI.Speech API only works from an MSIX-packaged app that
  declares the systemAIModels capability, so the packaged flavor exists purely to
  unlock the Windows on-device recognizer (NPU on Copilot+ PCs). The normal
  portable-zip distribution is unaffected.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap uap10 rescap systemai">

  <Identity Name="AccessibleLiveCaptions"
            Publisher="CN=Kelly Ford"
            Version="0.1.0.0"
            ProcessorArchitecture="arm64" />

  <Properties>
    <DisplayName>Accessible Live Captions</DisplayName>
    <PublisherDisplayName>Kelly Ford</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- MaxVersionTested must be at least 10.0.26226.0 or the Windows AI model
         load fails with "Not declared by app". -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="AccessibleLiveCaptions.exe"
                 uap10:RuntimeBehavior="packagedClassicApp"
                 uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Accessible Live Captions"
                          Description="Accessible on-device live captions with a full, screen-reader-navigable transcript."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <systemai:Capability Name="systemAIModels" />
  </Capabilities>
</Package>
