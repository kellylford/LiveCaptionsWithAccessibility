<Window x:Class="AccessibleLiveCaptions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccessibleLiveCaptions"
        Title="Accessible Live Captions"
        Height="720" Width="900"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontSize="15"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FocusManager.FocusedElement="{Binding ElementName=TranscriptList}">

    <!-- Keyboard shortcuts are attached to the commands themselves (see code-behind
         InputGestures) so they work from anywhere in the window. -->
    <Window.Resources>
        <!-- Make keyboard focus obvious for sighted keyboard users. -->
        <Style TargetType="FrameworkElement">
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2"
                                               StrokeThickness="3"
                                               Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                               StrokeDashArray="1 0"
                                               SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ==================== Menu (discoverable, access keys) ==================== -->
        <!-- A menu bar is reached with Alt / F10 and navigated with the arrow keys,
             not Tab. IsTabStop=False keeps the bar itself out of the tab sequence;
             TabNavigation=None lets Tab pass over its items instead of into them.
             Alt/F10 activation and arrow navigation are provided by WPF's Menu. -->
        <Menu DockPanel.Dock="Top"
              IsTabStop="False"
              KeyboardNavigation.TabNavigation="None"
              Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
              Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
            <MenuItem Header="_Captions">
                <MenuItem x:Name="MenuToggleListen" Header="_Start listening"
                          Command="{x:Static local:MainWindow.ToggleListenCommand}"
                          InputGestureText="Ctrl+R" />
                <Separator />
                <MenuItem Header="Cl_ear transcript"
                          Command="{x:Static local:MainWindow.ClearCommand}"
                          InputGestureText="Ctrl+L" />
                <MenuItem Header="C_opy all"
                          Command="{x:Static local:MainWindow.CopyAllCommand}"
                          InputGestureText="Ctrl+Shift+C" />
                <MenuItem Header="Sa_ve transcript…"
                          Command="{x:Static local:MainWindow.SaveCommand}"
                          InputGestureText="Ctrl+S" />
            </MenuItem>

            <MenuItem x:Name="MenuAudio" Header="_Audio">
                <MenuItem Header="_Source">
                    <MenuItem x:Name="SrcMic" Header="_Microphone"
                              IsCheckable="True" IsChecked="True" Click="Source_Click" />
                    <MenuItem x:Name="SrcSystem" Header="S_ystem audio (what you hear)"
                              IsCheckable="True" Click="Source_Click" />
                </MenuItem>
                <MenuItem x:Name="MenuApplication" Header="A_pplication" IsEnabled="False"
                          SubmenuOpened="MenuApplication_SubmenuOpened" />
                <Separator />
                <MenuItem Header="_Engine">
                    <MenuItem x:Name="EngWhisper" Header="_Whisper — accurate, on-device"
                              IsCheckable="True" IsChecked="True" Click="Engine_Click" />
                    <MenuItem x:Name="EngSapi" Header="Windows s_peech — instant, mic only"
                              IsCheckable="True" Click="Engine_Click" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Larger text"
                          Command="{x:Static local:MainWindow.IncreaseFontCommand}"
                          InputGestureText="Ctrl+Plus" />
                <MenuItem Header="_Smaller text"
                          Command="{x:Static local:MainWindow.DecreaseFontCommand}"
                          InputGestureText="Ctrl+Minus" />
                <Separator />
                <MenuItem x:Name="MenuShowTimestamps" Header="Show _timestamps"
                          IsCheckable="True" IsChecked="False"
                          Checked="ShowTimestamps_Changed" Unchecked="ShowTimestamps_Changed" />
                <MenuItem x:Name="MenuAnnounce" Header="_Announce new captions to screen reader"
                          IsCheckable="True" IsChecked="True"
                          Checked="Announce_Changed" Unchecked="Announce_Changed"
                          InputGestureText="F8" />
            </MenuItem>
        </Menu>

        <!-- ==================== Status bar (live region) ==================== -->
        <Border DockPanel.Dock="Bottom" Padding="10,6"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text="Ready. Press Start listening (Control R) to begin."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Status"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <!-- ==================== Live (interim) caption ==================== -->
        <Border DockPanel.Dock="Bottom" Padding="12,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
                <TextBlock Text="Now hearing" FontWeight="Bold" Margin="0,0,0,4"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="InterimText"
                           Text="—"
                           FontSize="22"
                           TextWrapping="Wrap"
                           MinHeight="34"
                           FontStyle="Italic"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           AutomationProperties.Name="Live caption in progress" />
            </StackPanel>
        </Border>

        <!-- ==================== Transcript (the core: full, scrollable history) ==================== -->
        <Grid Margin="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label x:Name="TranscriptLabel"
                   Grid.Row="0"
                   Target="{Binding ElementName=TranscriptList}"
                   Content="_Transcript"
                   FontWeight="Bold"
                   Margin="0,0,0,4"
                   AutomationProperties.HeadingLevel="Level2" />

            <ListBox x:Name="TranscriptList"
                     Grid.Row="1"
                     FontSize="22"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                     Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                     Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch"
                     KeyboardNavigation.TabNavigation="Once"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     AutomationProperties.Name="Transcript">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,4" />
                        <!-- Make the screen reader read the caption text, not the object's type name. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Timestamp}"
                                       Visibility="{Binding TimestampVisibility}"
                                       FontSize="13"
                                       Margin="0,2,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

    </DockPanel>
</Window>
