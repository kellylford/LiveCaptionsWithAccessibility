<Window x:Class="AccessibleLiveCaptions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccessibleLiveCaptions"
        Title="Accessible Live Captions"
        Height="720" Width="900"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontSize="15"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Keyboard shortcuts are attached to the commands themselves (see code-behind
         InputGestures) so they work from anywhere in the window. -->
    <Window.Resources>
        <!-- Make keyboard focus obvious for sighted keyboard users. -->
        <Style TargetType="FrameworkElement">
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2"
                                               StrokeThickness="3"
                                               Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                               StrokeDashArray="1 0"
                                               SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ==================== Menu (discoverable, access keys) ==================== -->
        <!-- A menu bar is reached with Alt / F10 and navigated with the arrow keys,
             not Tab. IsTabStop=False keeps the bar itself out of the tab sequence;
             TabNavigation=None lets Tab pass over its items instead of into them.
             Alt/F10 activation and arrow navigation are provided by WPF's Menu. -->
        <Menu DockPanel.Dock="Top"
              IsTabStop="False"
              KeyboardNavigation.TabNavigation="None"
              Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
              Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
            <MenuItem Header="_Captions">
                <MenuItem x:Name="MenuToggleListen" Header="_Start listening"
                          Command="{x:Static local:MainWindow.ToggleListenCommand}"
                          InputGestureText="Ctrl+R" />
                <Separator />
                <MenuItem Header="Cl_ear transcript"
                          Command="{x:Static local:MainWindow.ClearCommand}"
                          InputGestureText="Ctrl+L" />
                <MenuItem Header="C_opy all"
                          Command="{x:Static local:MainWindow.CopyAllCommand}"
                          InputGestureText="Ctrl+Shift+C" />
                <MenuItem Header="Sa_ve transcript…"
                          Command="{x:Static local:MainWindow.SaveCommand}"
                          InputGestureText="Ctrl+S" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Larger text"
                          Command="{x:Static local:MainWindow.IncreaseFontCommand}"
                          InputGestureText="Ctrl+Plus" />
                <MenuItem Header="_Smaller text"
                          Command="{x:Static local:MainWindow.DecreaseFontCommand}"
                          InputGestureText="Ctrl+Minus" />
                <Separator />
                <MenuItem x:Name="MenuShowTimestamps" Header="Show _timestamps"
                          IsCheckable="True" IsChecked="False"
                          Checked="ShowTimestamps_Changed" Unchecked="ShowTimestamps_Changed" />
                <MenuItem x:Name="MenuAnnounce" Header="_Announce new captions to screen reader"
                          IsCheckable="True" IsChecked="True"
                          Checked="Announce_Changed" Unchecked="Announce_Changed"
                          InputGestureText="F8" />
                <MenuItem Header="_Go to transcript"
                          Command="{x:Static local:MainWindow.FocusTranscriptCommand}"
                          InputGestureText="Ctrl+T" />
            </MenuItem>
        </Menu>

        <!-- ==================== Action toolbar ====================
             A real ToolBar is a single tab stop; Left/Right arrows move between its
             buttons. IsLocked hides the drag gripper. F6 cycles between this toolbar,
             the settings toolbar, and the transcript (handled in code-behind). -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True"
                     Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <ToolBar x:Name="ActionToolBar" KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Caption controls"
                     ToolBarTray.IsLocked="True">
                <Button x:Name="ListenButton"
                        Content="_Start listening"
                        Command="{x:Static local:MainWindow.ToggleListenCommand}"
                        Padding="14,6" MinWidth="150" FontWeight="Bold"
                        AutomationProperties.Name="Start listening"
                        AutomationProperties.HelpText="Starts or stops live captioning. Shortcut Control R." />
                <Separator />
                <Button Content="Cl_ear"
                        Command="{x:Static local:MainWindow.ClearCommand}"
                        Padding="12,6"
                        AutomationProperties.Name="Clear transcript" />
                <Button Content="C_opy all"
                        Command="{x:Static local:MainWindow.CopyAllCommand}"
                        Padding="12,6"
                        AutomationProperties.Name="Copy entire transcript" />
                <Button Content="Sa_ve…"
                        Command="{x:Static local:MainWindow.SaveCommand}"
                        Padding="12,6"
                        AutomationProperties.Name="Save transcript to a text file" />
                <Separator />
                <Button Content="A−"
                        Command="{x:Static local:MainWindow.DecreaseFontCommand}"
                        Padding="12,6"
                        AutomationProperties.Name="Smaller text" />
                <Button Content="A+"
                        Command="{x:Static local:MainWindow.IncreaseFontCommand}"
                        Padding="12,6"
                        AutomationProperties.Name="Larger text" />
            </ToolBar>
        </ToolBarTray>

        <!-- ==================== Settings toolbar (audio source & engine) ==================== -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True"
                     Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <ToolBar x:Name="SettingsToolBar" KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Audio source and engine"
                     ToolBarTray.IsLocked="True">
                <Label Content="_Audio source:" Target="{Binding ElementName=SourceCombo}"
                       VerticalAlignment="Center" />
                <ComboBox x:Name="SourceCombo" MinWidth="230" Margin="4,0,16,0"
                          VerticalAlignment="Center" SelectedIndex="0"
                          AutomationProperties.Name="Audio source"
                          AutomationProperties.HelpText="Choose whether to caption your microphone or all audio playing on this PC.">
                    <ComboBoxItem Content="Microphone" />
                    <ComboBoxItem Content="System audio (what you hear)" />
                </ComboBox>
                <Label Content="_Engine:" Target="{Binding ElementName=EngineCombo}"
                       VerticalAlignment="Center" />
                <ComboBox x:Name="EngineCombo" MinWidth="260" Margin="4,0,0,0"
                          VerticalAlignment="Center" SelectedIndex="0"
                          SelectionChanged="EngineCombo_SelectionChanged"
                          AutomationProperties.Name="Speech engine"
                          AutomationProperties.HelpText="Whisper is accurate and on-device. Windows speech is instant but microphone only.">
                    <ComboBoxItem Content="Whisper — accurate, on-device" />
                    <ComboBoxItem Content="Windows speech — instant, mic only" />
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <!-- ==================== Status bar (live region) ==================== -->
        <Border DockPanel.Dock="Bottom" Padding="10,6"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text="Ready. Press Start listening (Control R) to begin."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Status"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <!-- ==================== Live (interim) caption ==================== -->
        <Border DockPanel.Dock="Bottom" Padding="12,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
                <TextBlock Text="Now hearing" FontWeight="Bold" Margin="0,0,0,4"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="InterimText"
                           Text="—"
                           FontSize="22"
                           TextWrapping="Wrap"
                           MinHeight="34"
                           FontStyle="Italic"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           AutomationProperties.Name="Live caption in progress" />
            </StackPanel>
        </Border>

        <!-- ==================== Transcript (the core: full, scrollable history) ==================== -->
        <Grid Margin="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label x:Name="TranscriptLabel"
                   Grid.Row="0"
                   Target="{Binding ElementName=TranscriptList}"
                   Content="_Transcript"
                   FontWeight="Bold"
                   Margin="0,0,0,4"
                   AutomationProperties.HeadingLevel="Level2" />

            <ListBox x:Name="TranscriptList"
                     Grid.Row="1"
                     FontSize="22"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                     Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                     Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch"
                     KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Transcript. Use the arrow keys to review each caption line."
                     AutomationProperties.HelpText="A scrollable list of every finalized caption. Up and Down arrows move line by line; Home and End jump to the first or last line.">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Timestamp}"
                                       Visibility="{Binding TimestampVisibility}"
                                       FontSize="13"
                                       Margin="0,2,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

    </DockPanel>
</Window>
