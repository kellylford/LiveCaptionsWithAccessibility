<Window x:Class="AccessibleLiveCaptions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccessibleLiveCaptions"
        Title="Accessible Live Captions"
        Height="720" Width="900"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontSize="15"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FocusManager.FocusedElement="{Binding ElementName=TranscriptList}">

    <!-- Keyboard shortcuts are attached to the commands themselves (see code-behind
         InputGestures) so they work from anywhere in the window. -->
    <Window.Resources>
        <!-- Make keyboard focus obvious for sighted keyboard users. -->
        <Style TargetType="FrameworkElement">
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2"
                                               StrokeThickness="3"
                                               Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                               StrokeDashArray="1 0"
                                               SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ==================== Menu (discoverable, access keys) ==================== -->
        <!-- A menu bar is reached with Alt / F10 and navigated with the arrow keys,
             not Tab. IsTabStop=False keeps the bar itself out of the tab sequence;
             TabNavigation=None lets Tab pass over its items instead of into them.
             Alt/F10 activation and arrow navigation are provided by WPF's Menu. -->
        <Menu x:Name="MenuBar"
              DockPanel.Dock="Top"
              IsTabStop="False"
              KeyboardNavigation.TabNavigation="None"
              Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
              Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
            <MenuItem Header="_Captions">
                <MenuItem x:Name="MenuToggleListen" Header="_Start listening"
                          Command="{x:Static local:MainWindow.ToggleListenCommand}"
                          InputGestureText="Ctrl+R" />
                <Separator />
                <MenuItem Header="Cl_ear transcript"
                          Command="{x:Static local:MainWindow.ClearCommand}"
                          InputGestureText="Ctrl+L" />
                <MenuItem Header="C_opy all"
                          Command="{x:Static local:MainWindow.CopyAllCommand}"
                          InputGestureText="Ctrl+Shift+C" />
                <MenuItem Header="Sa_ve transcript…"
                          Command="{x:Static local:MainWindow.SaveCommand}"
                          InputGestureText="Ctrl+S" />
            </MenuItem>

            <MenuItem x:Name="MenuAudio" Header="_Audio">
                <MenuItem Header="_Source">
                    <MenuItem x:Name="SrcMic" Header="_Microphone"
                              IsCheckable="True" Click="Source_Click" />
                    <MenuItem x:Name="SrcSystem" Header="S_ystem audio (what you hear)"
                              IsCheckable="True" IsChecked="True" Click="Source_Click" />
                </MenuItem>
                <MenuItem x:Name="MenuApplication" Header="A_pplication" IsEnabled="False"
                          SubmenuOpened="MenuApplication_SubmenuOpened" />
                <MenuItem x:Name="MenuExcludeScreenReader" Header="Exclude screen _reader speech"
                          IsCheckable="True" IsChecked="True"
                          Checked="ExcludeScreenReader_Changed" Unchecked="ExcludeScreenReader_Changed" />
                <Separator />
                <MenuItem x:Name="MenuEngine" Header="_Engine"
                          SubmenuOpened="MenuEngine_SubmenuOpened">
                    <MenuItem x:Name="EngWhisper" Header="_Whisper — accurate, on-device"
                              IsCheckable="True" IsChecked="True" Click="Engine_Click" />
                    <MenuItem x:Name="EngStreaming" Header="S_treaming — word-by-word, lowest delay, on-device"
                              IsCheckable="True" Click="Engine_Click" />
                    <MenuItem x:Name="EngSapi" Header="Windows s_peech — instant, mic only"
                              IsCheckable="True" Click="Engine_Click" />
                </MenuItem>
                <MenuItem x:Name="MenuModel" Header="Whisper _model (speed vs. accuracy)">
                    <MenuItem Header="_Tiny — fastest, least accurate (75 MB)"
                              Tag="TinyEn" IsCheckable="True" Click="Model_Click" />
                    <MenuItem Header="_Base — balanced, default (141 MB)"
                              Tag="BaseEn" IsCheckable="True" IsChecked="True" Click="Model_Click" />
                    <MenuItem Header="_Small — more accurate, still real-time (465 MB)"
                              Tag="SmallEn" IsCheckable="True" Click="Model_Click" />
                    <MenuItem Header="_Medium — high accuracy, may lag live speech (1.5 GB)"
                              Tag="MediumEn" IsCheckable="True" Click="Model_Click" />
                    <MenuItem Header="Large v3 T_urbo — best accuracy that may keep up (1.6 GB)"
                              Tag="LargeV3Turbo" IsCheckable="True" Click="Model_Click" />
                    <MenuItem Header="_Large v3 — best accuracy, too slow for live use (2.9 GB)"
                              Tag="LargeV3" IsCheckable="True" Click="Model_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="MenuDownloadAll" Header="_Download all models (about 7.5 GB)"
                          Click="DownloadAllModels_Click" />
                <MenuItem Header="Clea_r downloaded models"
                          Click="ClearModels_Click" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Larger text"
                          Command="{x:Static local:MainWindow.IncreaseFontCommand}"
                          InputGestureText="Ctrl+Plus" />
                <MenuItem Header="_Smaller text"
                          Command="{x:Static local:MainWindow.DecreaseFontCommand}"
                          InputGestureText="Ctrl+Minus" />
                <Separator />
                <!-- Presentation: the same captions, two surfaces. Panel mode hides the
                     transcript and shows one caption at a time (what the built-in Live
                     Captions does), but keeps every line in memory and keeps announcing
                     finalized captions, so nothing is lost by switching. -->
                <MenuItem Header="_Presentation" InputGestureText="F7">
                    <!-- Driven by Checked/Unchecked, not Click: automation clients such as
                         Voice Access switch this through the UIA Toggle pattern, which
                         changes IsChecked without ever raising Click. -->
                    <MenuItem x:Name="MenuPresentTranscript"
                              Header="_Transcript — full, reviewable history"
                              IsCheckable="True" IsChecked="True"
                              Checked="Presentation_Changed" Unchecked="Presentation_Changed" />
                    <MenuItem x:Name="MenuPresentPanel"
                              Header="_Panel — one caption at a time"
                              IsCheckable="True"
                              Checked="Presentation_Changed" Unchecked="Presentation_Changed" />
                </MenuItem>
                <MenuItem Header="Pre_vious caption"
                          Command="{x:Static local:MainWindow.PanelPreviousCommand}"
                          InputGestureText="Alt+Up" />
                <MenuItem Header="Ne_xt caption"
                          Command="{x:Static local:MainWindow.PanelNextCommand}"
                          InputGestureText="Alt+Down" />
                <MenuItem Header="_Follow live captions"
                          Command="{x:Static local:MainWindow.FollowLiveCommand}"
                          InputGestureText="Alt+End" />
                <Separator />
                <MenuItem x:Name="MenuShowTimestamps" Header="Show _timestamps"
                          IsCheckable="True" IsChecked="False"
                          Checked="ShowTimestamps_Changed" Unchecked="ShowTimestamps_Changed" />
                <MenuItem x:Name="MenuAnnounce" Header="_Announce new captions to screen reader"
                          IsCheckable="True" IsChecked="True"
                          Checked="Announce_Changed" Unchecked="Announce_Changed"
                          InputGestureText="F8" />
            </MenuItem>
        </Menu>

        <!-- ==================== Status bar (live region) ==================== -->
        <Border DockPanel.Dock="Bottom" Padding="10,6"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text="Ready. Press Start listening (Control R) to begin."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Status"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <!-- ==================== Live (interim) caption ==================== -->
        <Border DockPanel.Dock="Bottom" Padding="12,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
                <TextBlock Text="Now hearing" FontWeight="Bold" Margin="0,0,0,4"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="InterimText"
                           Text="—"
                           FontSize="22"
                           TextWrapping="Wrap"
                           MinHeight="34"
                           FontStyle="Italic"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           AutomationProperties.Name="Live caption in progress" />
            </StackPanel>
        </Border>

        <!-- Exactly one presentation is visible at a time; both render the same _lines. -->
        <Grid>

        <!-- ==================== Transcript (the core: full, scrollable history) ==================== -->
        <Grid x:Name="TranscriptView" Margin="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label x:Name="TranscriptLabel"
                   Grid.Row="0"
                   Target="{Binding ElementName=TranscriptList}"
                   Content="_Transcript"
                   FontWeight="Bold"
                   Margin="0,0,0,4"
                   AutomationProperties.HeadingLevel="Level2" />

            <ListBox x:Name="TranscriptList"
                     Grid.Row="1"
                     FontSize="22"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                     Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                     Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch"
                     KeyboardNavigation.TabNavigation="Once"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     AutomationProperties.Name="Transcript">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,4" />
                        <!-- Make the screen reader read the caption text, not the object's type name. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Timestamp}"
                                       Visibility="{Binding TimestampVisibility}"
                                       FontSize="13"
                                       Margin="0,2,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ==================== Panel (one caption at a time) ==================== -->
        <!-- Deliberately has no focusable caption element: the caption text is delivered
             by the same UIA notification that transcript mode uses, so a screen reader
             hears each finalized line exactly once. Giving this TextBlock focus would
             make its Name change on every new caption, which some screen readers read
             as well — the announcement would arrive twice. -->
        <Grid x:Name="PanelView" Margin="12,10,12,8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Content="Caption"
                   FontWeight="Bold"
                   Margin="0,0,0,4"
                   AutomationProperties.HeadingLevel="Level2" />

            <Border Grid.Row="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    Padding="16">
                <!-- No AutomationProperties.Name: a TextBlock's own text becomes its
                     accessible name, so the caption reads as itself. -->
                <TextBlock x:Name="PanelCaption"
                           Text="—"
                           FontSize="32"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </Border>

            <!-- Controls for mouse and low-vision users. IsTabStop=False keeps the
                 "no tab stops anywhere" rule: the keyboard path is Alt+Up/Down/End and
                 the View menu, and these stay clickable and exposed to UIA regardless. -->
            <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                <Button x:Name="PanelPrev" DockPanel.Dock="Left"
                        Content="◀ Previous" AutomationProperties.Name="Previous caption"
                        IsTabStop="False" Focusable="False" Padding="12,4" Margin="0,0,6,0"
                        Command="{x:Static local:MainWindow.PanelPreviousCommand}"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Button x:Name="PanelNext" DockPanel.Dock="Left"
                        Content="Next ▶" AutomationProperties.Name="Next caption"
                        IsTabStop="False" Focusable="False" Padding="12,4" Margin="0,0,6,0"
                        Command="{x:Static local:MainWindow.PanelNextCommand}"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Button x:Name="PanelLive" DockPanel.Dock="Left"
                        Content="Follow live" AutomationProperties.Name="Follow live captions"
                        IsTabStop="False" Focusable="False" Padding="12,4"
                        Command="{x:Static local:MainWindow.FollowLiveCommand}"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <!-- No AutomationProperties.Name here either: a static name would hide the
                     live text ("Live — 8 captions" / "Caption 3 of 8 — paused") from a
                     screen reader, which is the only part worth reading. -->
                <TextBlock x:Name="PanelPosition" DockPanel.Dock="Right"
                           Text="No captions yet"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </DockPanel>
        </Grid>

        </Grid>

    </DockPanel>
</Window>
