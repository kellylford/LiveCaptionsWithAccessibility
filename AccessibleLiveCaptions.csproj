<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Opt-in Windows AI flavor (-p:WindowsAI=true): adds the experimental
         Microsoft.Windows.AI.Speech engine (NPU-backed, same model as Windows Live
         Captions). Needs a Windows-SDK-versioned TFM for WinRT projections and only
         functions when the app is MSIX-packaged with the systemAIModels capability;
         the default portable build is completely unaffected. -->
    <TargetFramework Condition="'$(WindowsAI)' == 'true'">net10.0-windows10.0.26100.0</TargetFramework>
    <DefineConstants Condition="'$(WindowsAI)' == 'true'">$(DefineConstants);WINDOWS_AI</DefineConstants>
    <!-- CS8305: "experimental API" notice on every Microsoft.Windows.AI.Speech use â€” known and accepted. -->
    <NoWarn Condition="'$(WindowsAI)' == 'true'">$(NoWarn);CS8305</NoWarn>
    <!-- win-arm64 is the default and the only fully verified target. Override with
         "dotnet publish -r win-x64" (or -p:RuntimeIdentifier=win-x64) for the
         experimental x64 build; the sherpa native runtime package below follows this
         value, which is the only thing that actually has to change per architecture. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AccessibleLiveCaptions</AssemblyName>
    <RootNamespace>AccessibleLiveCaptions</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The release workflow verifies the pushed v* tag matches <Version>. -->
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0</AssemblyVersion>
    <FileVersion>0.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Offline mic-only quick engine -->
    <PackageReference Include="System.Speech" Version="10.0.10" />
    <!-- System-audio + microphone capture (WASAPI); pure-managed, works on ARM64 -->
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- On-device high-accuracy speech-to-text; CPU runtime supports win-arm64 -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- On-device true-streaming speech-to-text (word-by-word captions). The native
         runtime is architecture-pinned, so the package name tracks $(RuntimeIdentifier):
         org.k2fsa.sherpa.onnx.runtime.win-arm64 / ...win-x64. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.$(RuntimeIdentifier)" Version="1.13.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsAI)' == 'true'">
    <!-- Windows AI Speech Recognition (experimental): the OS on-device recognizer,
         NPU-accelerated on Copilot+ PCs. Granular packages â€” no WinUI dependency. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.2.6-experimental" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsAI)' != 'true'">
    <Compile Remove="Speech\WindowsAiCaptionSource.cs" />
  </ItemGroup>

</Project>
